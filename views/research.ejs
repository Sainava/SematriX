<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Research Portal</title>
</head>
<body>
    <h1>Research Portal</h1>
    
    <!-- Search Form -->
    <form action="/research" method="POST">
        <input type="text" name="query" placeholder="🔎 Search papers..." required>
        <input type="number" name="max_results" placeholder="Max Results (default: 5)" min="1">
        <button type="submit">Search</button>
    </form>

    <!-- Error Handling -->
    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <!-- Display Papers -->
    <% if (papers && papers.length > 0) { %>
        <h2>Search Results:</h2>
        <ul>
            <% papers.forEach(paper => { %>
                <li>
                    <h3><%= paper.paper_title %></h3>
                    <p><strong>Authors:</strong> <%= paper.authors_list.join(", ") %></p>
                    <p><strong>Published Date:</strong> <%= paper.date_published %></p>
                    <p><strong>Abstract:</strong> <%= paper.abstract_text %></p>
                    <p><a href="<%= paper.arxiv_link %>" target="_blank">Read More</a></p>
                </li>
            <% }); %>
        </ul>
    <% } else if (!error) { %>
        <p>No research papers found.</p>
    <% } %>
</body>
</html>
